<mujoco model="tabletop_6cam">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="2d" name="charuco_tex" file="charuco_board.png"/>
    <material name="charuco_mat" texture="charuco_tex" reflectance="0.0"/>
    <texture type="2d" name="room_tex" file="room_texture.png"/>
    <material name="room_mat" texture="room_tex" reflectance="0.05"/>
    <material name="strobe_mat" rgba="0.1 0.1 0.1 1" emission="0.0"/>
    <material name="table_mat" texture="room_tex" rgba="0.75 0.70 0.65 1" specular="0.05" shininess="0.1"/>
  </asset>

  <worldbody>
    <light diffuse="0.45 0.45 0.45" pos="0 0 3.0" dir="0 0 -1" castshadow="true"/>
    <light diffuse="0.25 0.25 0.25" pos="1.5 1.5 2.5" dir="-1 -1 -1"/>
    <light diffuse="0.25 0.25 0.25" pos="-1.5 -1.5 2.5" dir="1 1 -1"/>

    <!-- Room Floor and Enclosing Walls -->
    <geom name="floor" type="plane" size="8 8 0.1" material="room_mat"/>
    <body name="walls" pos="0 0 1.5">
      <geom name="wall_n" type="box" size="4 0.05 1.5" pos="0 3.5 0" material="room_mat"/>
      <geom name="wall_s" type="box" size="4 0.05 1.5" pos="0 -3.5 0" material="room_mat"/>
      <geom name="wall_e" type="box" size="0.05 4 1.5" pos="3.5 0 0" material="room_mat"/>
      <geom name="wall_w" type="box" size="0.05 4 1.5" pos="-3.5 0 0" material="room_mat"/>
    </body>

    <!-- Table -->
    <body name="table" pos="0 0 0.35">
      <geom name="tabletop" type="box" size="0.6 0.5 0.35" material="table_mat"/>
    </body>

    <!-- ChArUco Board target flat on table (z = 0.701) -->
    <body name="charuco_target" pos="0.1 0.0 0.702">
      <geom name="charuco_geom" type="box" size="0.14 0.10 0.001" material="charuco_mat"/>
    </body>

    <!-- Sync Strobe Light indicator (toggled dynamically via geom material) -->
    <body name="sync_strobe_body" pos="0.0 0.3 0.71">
      <geom name="sync_strobe_geom" type="cylinder" size="0.03 0.005" material="strobe_mat"/>
      <site name="strobe_site" pos="0 0 0.005" size="0.03" rgba="0.2 0.2 0.2 1"/>
    </body>

    <!-- Tabletop graspable objects for rich visual features -->
    <body name="obj_red_cube" pos="-0.2 -0.1 0.73">
      <geom name="red_cube" type="box" size="0.025 0.025 0.025" rgba="0.85 0.15 0.15 1"/>
    </body>
    <body name="obj_blue_cylinder" pos="-0.25 0.15 0.73">
      <geom name="blue_cyl" type="cylinder" size="0.025 0.03" rgba="0.15 0.25 0.85 1"/>
    </body>
    <body name="obj_green_sphere" pos="0.3 -0.2 0.73">
      <geom name="green_sph" type="sphere" size="0.03" rgba="0.15 0.85 0.25 1"/>
    </body>
    <body name="obj_yellow_cube" pos="-0.05 -0.25 0.73">
      <geom name="yellow_cube" type="box" size="0.02 0.02 0.02" rgba="0.9 0.85 0.1 1"/>
    </body>

    <!-- Fixed Corner Surveillance Cameras (looking at table center [0, 0, 0.7]) -->
    <camera name="cam_corner_fl" pos="-0.8 -0.6 1.2" xyaxes="0.6 -0.8 0 0.44 0.33 0.83" fovy="80"/>
    <camera name="cam_corner_fr" pos="0.8 -0.6 1.2" xyaxes="0.6 0.8 0 -0.44 0.33 0.83" fovy="80"/>
    <camera name="cam_corner_rl" pos="-0.8 0.6 1.2" xyaxes="-0.6 -0.8 0 0.44 -0.33 0.83" fovy="80"/>
    <camera name="cam_corner_rr" pos="0.8 0.6 1.2" xyaxes="-0.6 0.8 0 -0.44 -0.33 0.83" fovy="80"/>

    <!-- Fixed Overhead Stereo Pair (Baseline = 0.12m along x) -->
    <camera name="cam_stereo_left" pos="-0.06 0.0 1.3" xyaxes="1 0 0 0 1 0" fovy="75"/>
    <camera name="cam_stereo_right" pos="0.06 0.0 1.3" xyaxes="1 0 0 0 1 0" fovy="75"/>

    <!-- Kinematically driven Mocap Rig / Wrist Body -->
    <body name="wrist_body" mocap="true" pos="0.0 -0.2 0.95">
      <geom name="wrist_geom" type="sphere" size="0.02" pos="0 0 0.04" rgba="0.7 0.7 0.7 0.6"/>
      <!-- Wrist camera looking downwards towards table -->
      <camera name="cam_wrist" pos="0 0 0" xyaxes="1 0 0 0 1 0" fovy="65"/>
      <site name="imu_rig_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
    </body>
  </worldbody>

  <sensor>
    <accelerometer site="imu_rig_site" name="imu_accel"/>
    <gyro site="imu_rig_site" name="imu_gyro"/>
    <framequat objtype="site" objname="imu_rig_site" name="imu_quat"/>
  </sensor>
</mujoco>
