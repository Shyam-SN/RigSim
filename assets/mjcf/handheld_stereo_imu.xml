<mujoco model="handheld_stereo_imu">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="2d" name="charuco_tex" file="charuco_board.png"/>
    <material name="charuco_mat" texture="charuco_tex" reflectance="0.0"/>
    <texture type="2d" name="room_tex" file="room_texture.png"/>
    <material name="room_mat" texture="room_tex" reflectance="0.1"/>
    <material name="strobe_mat" rgba="0.1 0.1 0.1 1" emission="0.0"/>
  </asset>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 3.0" dir="0 0 -1" castshadow="true"/>
    <light diffuse="0.5 0.5 0.5" pos="1.5 1.5 2.5" dir="-1 -1 -1"/>
    <light diffuse="0.5 0.5 0.5" pos="-1.5 -1.5 2.5" dir="1 1 -1"/>

    <!-- Room floor, walls and ceiling with fiducial texture -->
    <geom name="floor" type="plane" size="4 4 0.1" material="room_mat"/>

    <!-- Front wall with ChArUco target -->
    <body name="front_wall" pos="0 3.0 1.5">
      <geom name="wall_geom" type="box" size="3.0 0.05 1.5" material="room_mat"/>
      <geom name="charuco_geom" type="box" size="0.25 0.001 0.18" pos="0.0 -0.06 0.0" material="charuco_mat"/>
      <site name="strobe_site" pos="0.4 -0.06 0.0" size="0.04" rgba="0.2 0.2 0.2 1"/>
    </body>

    <!-- Static background objects for visual parallax and optical flow -->
    <body name="pillar1" pos="-1.5 1.5 0.75">
      <geom name="p1" type="box" size="0.15 0.15 0.75" rgba="0.8 0.3 0.3 1"/>
    </body>
    <body name="pillar2" pos="1.5 2.0 0.9">
      <geom name="p2" type="cylinder" size="0.2 0.9" rgba="0.3 0.4 0.8 1"/>
    </body>

    <!-- Kinematically driven Handheld Rig body -->
    <body name="handheld_rig" mocap="true" pos="0 0 1.2">
      <geom name="rig_chassis" type="box" size="0.08 0.03 0.03" rgba="0.2 0.2 0.2 0.8"/>
      <!-- Stereo pair: cam0 (left) at -0.055m, cam1 (right) at +0.055m (0.11m baseline) -->
      <!-- In MuJoCo camera: -Z is lookat, +Y is up. We look forward along +Y world when rig is identity: xyaxes="1 0 0 0 0 1" -->
      <camera name="cam0" pos="-0.055 0.03 0" xyaxes="1 0 0 0 0 1" fovy="75"/>
      <camera name="cam1" pos="0.055 0.03 0" xyaxes="1 0 0 0 0 1" fovy="75"/>
      <site name="imu0_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
    </body>
  </worldbody>

  <sensor>
    <accelerometer site="imu0_site" name="imu_accel"/>
    <gyro site="imu0_site" name="imu_gyro"/>
    <framequat objtype="site" objname="imu0_site" name="imu_quat"/>
  </sensor>
</mujoco>

